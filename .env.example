# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=medtrack-secret-key-2026-nep-project

# Database Configuration (Option B: Turso Cloud DB vs Option A: Local SQLite File)
# ------------------------------------------------------------------------------
# For Local SQLite File (Default - zero configuration):
# Leave DATABASE_URL commented out or set to: file:medtrack.db
# DATABASE_URL=file:medtrack.db

# For Turso Cloud DB (Remote LibSQL Database for production / multi-device):
# 1. Create a database at https://turso.tech (or run `turso db create medtrack-db`)
# 2. Get your database URL and token (run `turso db show medtrack-db --url` and `turso db tokens create medtrack-db`)
DATABASE_URL=libsql://your-database-name.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token
